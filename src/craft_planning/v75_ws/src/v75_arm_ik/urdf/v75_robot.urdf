    <child link="jaw_upper_link_vis_orange" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="carousel_link_vis_orange_joint" type="fixed">
    <parent link="carousel_link" />
    <child link="carousel_link_vis_orange" />
    <origin xyz="0 0 0" rpy="0 0 0" />
