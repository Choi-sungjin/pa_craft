  <joint name="jaw_lower_link_vis_orange_joint" type="fixed">
    <parent link="jaw_lower_link" />
    <child link="jaw_lower_link_vis_orange" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <!-- 카메라 (그리퍼 옆 노란 상자). 렌즈 중심 = tool_roll_link 기준 (-65, 55.8, 0) mm, 그리퍼와 같은 방향(아래)을 봄.
       광학 프레임 관례: z = 보는 방향(tool +y), x = tool +x -->
  <link name="camera_optical_frame" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="tool_roll_link" />
    <child link="camera_optical_frame" />
    <origin xyz="-0.065 0.0558 0" rpy="-1.5707963 0 0" />
  </joint>
</robot>
