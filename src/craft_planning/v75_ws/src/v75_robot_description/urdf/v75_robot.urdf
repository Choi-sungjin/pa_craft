<?xml version='1.0' encoding='utf-8'?>
<robot name="v75_robot">
  <!-- 노브(selector)와 앞쪽 받침대는 로봇이 아니라 경기장 물체라서 urdf/knob_station.urdf 로 분리함 -->
  <material name="body_slate">
    <color rgba="0.55 0.63 0.78 1" />
  </material>
  <material name="orange">
    <color rgba="1.0 0.55 0.12 1" />
  </material>
  <material name="mint">
    <color rgba="0.20 0.85 0.62 1" />
  </material>
  <material name="yellow">
    <color rgba="1.0 0.84 0.10 1" />
  </material>
  <material name="light_gray">
    <color rgba="0.82 0.84 0.88 1" />
  </material>
  <material name="gripper_violet">
    <color rgba="0.62 0.45 1.0 1" />
  </material>
  <material name="jaw_pink">
    <color rgba="1.0 0.30 0.55 1" />
  </material>
  <material name="jaw_sky">
    <color rgba="0.20 0.62 1.0 1" />
  </material>
  <material name="knob_red">
    <color rgba="0.95 0.15 0.20 1" />
  </material>
  <material name="pad_white">
    <color rgba="0.97 0.97 0.97 1" />
  </material>
  <!--Visual / kinematic export. q=0 is the saved V75 CAD pose. Not a hardware controller or dynamics model.-->
  <link name="base_link">
    <visual name="base_link_black">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/base_link_black.stl" scale="1 1 1" />
      </geometry>
      <material name="body_slate" />
    </visual>
  </link>
  <link name="slide_link">
    <visual name="slide_link_green">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/slide_link_green.stl" scale="1 1 1" />
      </geometry>
      <material name="mint" />
    </visual>
    <!-- added: slide_link_gray.stl was in meshes/ but not referenced -->
  </link>
  <link name="shoulder_link">
    <visual name="shoulder_link_orange">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/shoulder_link_orange.stl" scale="1 1 1" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <link name="elbow_link">
    <visual name="elbow_link_black">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/elbow_link_black.stl" scale="1 1 1" />
      </geometry>
      <material name="body_slate" />
    </visual>
  </link>
  <link name="wrist_pitch_link">
    <visual name="wrist_pitch_link_orange">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/wrist_pitch_link_orange.stl" scale="1 1 1" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <link name="tool_roll_link">
    <visual name="tool_roll_link_black">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/tool_roll_link_black.stl" scale="1 1 1" />
      </geometry>
      <material name="gripper_violet" />
    </visual>
  </link>
  <link name="jaw_upper_link">
    <visual name="jaw_upper_link_black">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/jaw_upper_link_black.stl" scale="1 1 1" />
      </geometry>
      <material name="jaw_pink" />
    </visual>
  </link>
  <link name="carousel_link">
    <visual name="carousel_link_black">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/carousel_link_black.stl" scale="1 1 1" />
      </geometry>
      <material name="body_slate" />
    </visual>
  </link>
  <link name="jaw_lower_link">
    <visual name="jaw_lower_link_black">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/jaw_lower_link_black.stl" scale="1 1 1" />
      </geometry>
      <material name="jaw_sky" />
    </visual>
  </link>
  <link name="idler_link" />
  <!-- added: grasp center between the two jaw pads (measured from jaw meshes at q=0).
       그리퍼 메시를 15° 보정한 뒤 잡는 점이 비틀기 축 위에 옴 -->
  <link name="tool_tcp" />
  <joint name="slide_joint" type="prismatic">
    <parent link="base_link" />
    <child link="slide_link" />
    <!-- Measured: carriage block left edge 36 mm from the waffle's LM-motor edge at the motor end
         stop (motor 808.1 deg); was x 0.02, which drew the carriage 31.4 mm too far from the motor.
         +10 mm after the first puck pick on hardware went 1 cm past the puck (2026-10-24). -->
    <origin xyz="-0.00135 0 0" rpy="0 0 0" />
    <!-- + moves the carriage toward the LM motor (-X), matching motor raw +. -->
    <axis xyz="-1 0 0" />
    <!-- 5-degree margin inside measured motor limits (-136.4..803.1 deg, control.yaml); lower was a
         stale -0.0320 (2026-10-26); previous lower=-0.032 upper=0.072. -->
    <limit effort="0" velocity="0" lower="-0.0438" upper="0.0630" />
  </joint>
  <joint name="shoulder_joint" type="revolute">
    <parent link="slide_link" />
    <child link="shoulder_link" />
    <!-- Shoulder axis measured 114 mm above the floor (wheel bottom = base_link z 0) (2026-10-27);
         was 0.12225 (122.25 mm, CAD), which put every TCP 8.25 mm above the real one. -->
    <origin xyz="0.129 0.051 0.114" rpy="0 0 0" />
    <axis xyz="1 -4.17700833006e-17 -1.45864345059e-18" />
    <!-- 5-degree margin inside measured motor limits; previous lower=-0.4721 upper=2.1110. -->
    <limit effort="0" velocity="0" lower="-0.3848" upper="2.0237" />
  </joint>
  <joint name="elbow_joint" type="revolute">
    <parent link="shoulder_link" />
    <child link="elbow_link" />
    <!-- Measured 187 mm axis to axis (2026-10-26), CAD direction kept (scripts/fit_measured.py);
         was 0 0.077280 0.173574 (190 mm), CAD 0 0.0764664888983 0.171746546037 (188.0 mm). -->
    <origin xyz="0 0.076060 0.170833" rpy="0 0 0" />
    <axis xyz="1 -6.34787704949e-17 -3.21286950234e-19" />
    <!-- 5-degree margin inside measured motor limits; previous lower=-1.5252 upper=3.4490. -->
    <limit effort="0" velocity="0" lower="-1.4379" upper="3.4490" />
  </joint>
  <joint name="wrist_pitch_joint" type="revolute">
    <parent link="elbow_link" />
    <child link="wrist_pitch_link" />
    <!-- Centered on the forearm wrist-pitch motor horn (was 0.0835666 0.0451843, 24 mm above it).
         Measured 95 mm axis to axis (2026-10-26), direction kept; was 0 0.089498 0.021309 (92 mm). -->
    <origin xyz="0 0.092417 0.022004" rpy="0 0 0" />
    <axis xyz="1 -6.34787704949e-17 -3.21286950234e-19" />
    <!-- 5-degree margin inside measured motor limits 70.1–340 deg (2026-10-26); previous lower=-0.4370 upper=1.5876. -->
    <limit effort="0" velocity="0" lower="-2.3655" upper="2.3537" />
  </joint>
  <joint name="tool_roll_joint" type="revolute">
    <parent link="wrist_pitch_link" />
    <child link="tool_roll_link" />
    <!-- Measured 78 mm from the wrist-pitch axis to the tool-roll motor horn (2026-10-26); was 0.055. -->
    <origin xyz="0 0.078 0" rpy="0 0 0" />
    <axis xyz="-2.58569494309e-15 1 7.70863789488e-17" />
    <!-- 5-degree margin inside measured motor limits -180–180 deg, aligned at 90 deg (2026-10-26);
         previous lower=-4.7226 upper=3.8295. -->
    <limit effort="0" velocity="0" lower="-4.6250" upper="1.4835" />
  </joint>
  <joint name="jaw_upper_joint" type="prismatic">
    <parent link="tool_roll_link" />
    <child link="jaw_upper_link" />
    <origin xyz="0 -1.66533453694e-16 -0.01" rpy="0 0 0" />
    <axis xyz="-2.77555756156e-13 5.55111512312e-14 -1" />
    <limit effort="0" velocity="0" lower="-0.021" upper="0.01" />
  </joint>
  <joint name="carousel_joint" type="continuous">
    <parent link="base_link" />
    <child link="carousel_link" />
    <origin xyz="0.129 0.23 0.1" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="0" velocity="0" />
  </joint>
  <joint name="jaw_lower_joint" type="prismatic">
    <parent link="tool_roll_link" />
    <child link="jaw_lower_link" />
    <origin xyz="0 -1.11022302463e-16 0.01" rpy="0 0 0" />
    <axis xyz="-3.57353036051e-13 5.55111512313e-14 1" />
    <limit effort="0" velocity="0" lower="-0.021" upper="0.01" />
    <!-- One gripper motor drives both jaws symmetrically. -->
    <mimic joint="jaw_upper_joint" multiplier="1" offset="0" />
  </joint>
  <joint name="idler_joint" type="continuous">
    <parent link="base_link" />
    <child link="idler_link" />
    <!-- Follows the LM plate refit to its measured span (scripts/fit_measured.py); was x 0.234. -->
    <origin xyz="0.22164 0.0563662 0.0955" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit effort="0" velocity="0" />
  </joint>
  <joint name="tool_tcp_joint" type="fixed">
    <parent link="tool_roll_link" />
    <child link="tool_tcp" />
    <!-- Measured horn face to open fingertip 133 mm (horn->gripper 48 + gripper 85; CAD 125.3), jaws stretched
         by fit_measured.py. TCP at the middle of the 30 mm usable grip, 15 mm behind the tip; was 0.115 (36 mm grip). -->
    <origin xyz="0 0.118 0" rpy="0 0 0" />
  </joint>
  <link name="base_link_vis_green">
    <visual name="base_link_green">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/base_link_green.stl" scale="1 1 1" />
      </geometry>
      <material name="mint" />
    </visual>
  </link>
  <link name="base_link_vis_orange">
    <visual name="base_link_orange">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/base_link_orange.stl" scale="1 1 1" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <link name="base_link_vis_yellow">
    <visual name="base_link_yellow">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/base_link_yellow.stl" scale="1 1 1" />
      </geometry>
      <material name="yellow" />
    </visual>
  </link>
  <link name="slide_link_vis_black">
    <visual name="slide_link_black">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/slide_link_black.stl" scale="1 1 1" />
      </geometry>
      <material name="body_slate" />
    </visual>
  </link>
  <link name="slide_link_vis_orange">
    <visual name="slide_link_orange">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/slide_link_orange.stl" scale="1 1 1" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <link name="slide_link_vis_gray">
    <visual name="slide_link_gray">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/slide_link_gray.stl" scale="1 1 1" />
      </geometry>
      <material name="light_gray" />
    </visual>
  </link>
  <link name="shoulder_link_vis_black">
    <visual name="shoulder_link_black">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/shoulder_link_black.stl" scale="1 1 1" />
      </geometry>
      <material name="body_slate" />
    </visual>
  </link>
  <link name="shoulder_link_vis_green">
    <visual name="shoulder_link_green">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/shoulder_link_green.stl" scale="1 1 1" />
      </geometry>
      <material name="mint" />
    </visual>
  </link>
  <link name="wrist_pitch_link_vis_black">
    <visual name="wrist_pitch_link_black">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/wrist_pitch_link_black.stl" scale="1 1 1" />
      </geometry>
      <material name="body_slate" />
    </visual>
  </link>
  <link name="tool_roll_link_vis_yellow">
    <visual name="tool_roll_link_yellow">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/tool_roll_link_yellow.stl" scale="1 1 1" />
      </geometry>
      <material name="yellow" />
    </visual>
  </link>
  <link name="tool_roll_link_vis_orange">
    <visual name="tool_roll_link_orange">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/tool_roll_link_orange.stl" scale="1 1 1" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <link name="tool_roll_link_vis_green">
    <visual name="tool_roll_link_green">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/tool_roll_link_green.stl" scale="1 1 1" />
      </geometry>
      <material name="mint" />
    </visual>
  </link>
  <link name="jaw_upper_link_vis_orange">
    <visual name="jaw_upper_link_orange">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/jaw_upper_link_orange.stl" scale="1 1 1" />
      </geometry>
      <material name="pad_white" />
    </visual>
  </link>
  <link name="carousel_link_vis_orange">
    <visual name="carousel_link_orange">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/carousel_link_orange.stl" scale="1 1 1" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>
  <link name="carousel_link_vis_green">
    <visual name="carousel_link_green">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/carousel_link_green.stl" scale="1 1 1" />
      </geometry>
      <material name="mint" />
    </visual>
  </link>
  <link name="jaw_lower_link_vis_orange">
    <visual name="jaw_lower_link_orange">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://v75_robot_description/meshes/jaw_lower_link_orange.stl" scale="1 1 1" />
      </geometry>
      <material name="pad_white" />
    </visual>
  </link>
  <joint name="base_link_vis_green_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_link_vis_green" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="base_link_vis_orange_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_link_vis_orange" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="base_link_vis_yellow_joint" type="fixed">
    <parent link="base_link" />
    <child link="base_link_vis_yellow" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="slide_link_vis_black_joint" type="fixed">
    <parent link="slide_link" />
    <child link="slide_link_vis_black" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="slide_link_vis_orange_joint" type="fixed">
    <parent link="slide_link" />
    <child link="slide_link_vis_orange" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="slide_link_vis_gray_joint" type="fixed">
    <parent link="slide_link" />
    <child link="slide_link_vis_gray" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="shoulder_link_vis_black_joint" type="fixed">
    <parent link="shoulder_link" />
    <child link="shoulder_link_vis_black" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="shoulder_link_vis_green_joint" type="fixed">
    <parent link="shoulder_link" />
    <child link="shoulder_link_vis_green" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="wrist_pitch_link_vis_black_joint" type="fixed">
    <parent link="wrist_pitch_link" />
    <child link="wrist_pitch_link_vis_black" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="tool_roll_link_vis_yellow_joint" type="fixed">
    <parent link="tool_roll_link" />
    <child link="tool_roll_link_vis_yellow" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="tool_roll_link_vis_orange_joint" type="fixed">
    <parent link="tool_roll_link" />
    <child link="tool_roll_link_vis_orange" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="tool_roll_link_vis_green_joint" type="fixed">
    <parent link="tool_roll_link" />
    <child link="tool_roll_link_vis_green" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="jaw_upper_link_vis_orange_joint" type="fixed">
    <parent link="jaw_upper_link" />
    <child link="jaw_upper_link_vis_orange" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="carousel_link_vis_orange_joint" type="fixed">
    <parent link="carousel_link" />
    <child link="carousel_link_vis_orange" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
  <joint name="carousel_link_vis_green_joint" type="fixed">
    <parent link="carousel_link" />
    <child link="carousel_link_vis_green" />
