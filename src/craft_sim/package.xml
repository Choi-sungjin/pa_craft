<?xml version="1.0"?>
<package format="3">
  <name>craft_sim</name>
  <version>0.1.0</version>
  <description>2D planning simulator: real planning_master/control_master with a fake wheel OpenCR (PTY) and ground-truth perception</description>
  <maintainer email="208406003+Choi-sungjin@users.noreply.github.com">SungjinChoi</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>craft_interfaces</exec_depend>
  <exec_depend>craft_planning</exec_depend>
  <exec_depend>craft_control</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
