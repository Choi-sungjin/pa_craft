[Unit]
Description=craft voice: Bluetooth mic with WebRTC noise suppression + AGC (virtual source craft_mic_clean)
After=pipewire.service wireplumber.service
Requires=pipewire.service

[Service]
ExecStart=/usr/bin/pipewire -c %h/.config/pipewire/craft-mic-clean.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
