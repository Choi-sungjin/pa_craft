# OpenAI key for craft_voice (voice_node, demo, bench).
#   cp openai.env.example openai.env      (same folder) and put your key below.
# openai.env is git-ignored: never commit it, never paste the key into a chat.
# Variables already set in the shell win over this file.
OPENAI_API_KEY=sk-put-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
