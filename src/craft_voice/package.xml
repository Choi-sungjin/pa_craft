<?xml version="1.0"?>
<package format="3">
  <name>craft_voice</name>
  <version>0.0.0</version>
  <description>Voice narration: camera + planning state machine -> GPT (OpenAI) -> speech</description>
  <maintainer email="sssgggjjj4895@gmail.com">pa29</maintainer>
  <license>TODO</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
